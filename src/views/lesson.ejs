<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><a href="/learn/<%= module.slug %>" class="back-link"><i class="bi bi-arrow-left"></i> <%= module.title %></a><div class="row g-4 mt-1"><aside class="col-lg-3"><div class="lesson-sidebar"><span class="section-kicker">ON THIS MODULE</span><h5 class="mt-2"><%= module.title %></h5><nav class="lesson-nav mt-3" aria-label="Materi dalam modul"><% lessons.forEach((l,i)=>{ %><a href="/learn/<%= module.slug %>/<%= l.slug %>" class="lesson-nav-item <%= l.id===lesson.id?'selected':'' %>"><span><%= i+1 %>.</span><%= l.title %></a><% }) %></nav><a href="<%= user?'/practice/'+module.slug:'/login?next='+encodeURIComponent('/practice/'+module.slug) %>" class="btn btn-brand w-100 mt-3 btn-sm">Latihan Modul</a></div></aside><article class="col-lg-9"><div class="article-card"><div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><span class="tag-soft">LESSON <%= index+1 %> / <%= lessons.length %></span><span class="muted small"><i class="bi bi-book"></i> Free lesson</span></div><div class="lesson-content"><%- html %></div><div class="lesson-practice-banner rounded-3 p-3 mb-3"><div class="d-flex flex-wrap align-items-center justify-content-between gap-2"><div><strong>Latihan topik ini</strong><div class="muted small">Uji pemahaman khusus tentang <%= lesson.title %>.</div></div><a class="btn btn-brand btn-sm" href="<%= user?'/practice/'+module.slug+'?lesson='+lesson.slug:'/login?next='+encodeURIComponent('/practice/'+module.slug+'?lesson='+lesson.slug) %>">Latihan topik ini <i class="bi bi-arrow-right"></i></a></div></div><hr><div class="d-flex justify-content-between flex-wrap gap-2 mt-4"><% if(index>0){ %><a class="btn btn-outline-dark" href="/learn/<%= module.slug %>/<%= lessons[index-1].slug %>"><i class="bi bi-arrow-left"></i> Sebelumnya</a><% }else{ %><span></span><% } %><% if(index<lessons.length-1){ %><a class="btn btn-brand" href="/learn/<%= module.slug %>/<%= lessons[index+1].slug %>">Berikutnya <i class="bi bi-arrow-right"></i></a><% }else{ %><a class="btn btn-brand" href="<%= user?'/practice/'+module.slug:'/login?next='+encodeURIComponent('/practice/'+module.slug) %>">Mulai Latihan <i class="bi bi-arrow-right"></i></a><% } %></div></div></article></div></main><%- include('partials/footer') %>
