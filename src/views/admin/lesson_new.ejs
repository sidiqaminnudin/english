<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><a href="/admin/lessons" class="back-link"><i class="bi bi-arrow-left"></i> Daftar materi</a><div class="page-intro mt-3"><span class="section-kicker">CONTENT EDITOR</span><h1>Tambah Materi</h1><p class="muted">Materi baru dapat diterbitkan segera, atau disimpan sebagai Draft terlebih dahulu.</p></div><div class="panel p-4"><form action="/admin/lessons/new" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-6"><label for="module_id" class="form-label">Modul</label><select class="form-select" id="module_id" name="module_id" required><option value="">Pilih modul</option><% modules.forEach(m=>{ %><option value="<%= m.id %>"><%= m.title %></option><% }) %></select></div><div class="col-md-6"><label for="slug" class="form-label">Slug</label><input id="slug" class="form-control" name="slug" placeholder="introduction-to-topic" pattern="[a-z0-9-]{3,100}" required></div><div class="col-12"><label for="title" class="form-label">Judul materi</label><input id="title" class="form-control" name="title" maxlength="160" required></div><div class="col-12"><label for="summary" class="form-label">Ringkasan</label><textarea id="summary" name="summary" class="form-control" rows="2"></textarea></div><div class="col-12"><label for="body_md" class="form-label">Materi Markdown</label><textarea id="body_md" name="body_md" class="form-control code-editor" rows="16" placeholder="# Judul materi&#10;&#10;Penjelasan teori..." required></textarea></div><div class="col-12"><div class="form-check form-switch"><input id="is_published" type="checkbox" class="form-check-input" name="is_published"><label class="form-check-label" for="is_published">Publish materi</label></div></div><div class="col-12"><button class="btn btn-brand" type="submit">Simpan Materi</button><a class="btn btn-outline-dark ms-2" href="/admin/lessons">Batal</a></div></div></form></div></main><%- include('../partials/footer') %>
