<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="section-kicker">STUDENT RESULTS</span><h1>Detail Hasil Ujian</h1><p class="muted"><%= result.full_name %> (<%= result.username %>) · <%= result.module_title %> · <%= result.mode==='exam'?'Exam':'Latihan' %></p></div><%- include('../partials/adminnav') %><div class="panel p-4 mb-4"><h2 class="h4">Nilai: <%= result.score %> / 100</h2><p class="mb-0"><%= result.correct_count %> benar dari <%= result.question_count %> soal · KKM <%= result.passing_score %> · <strong><%= Number(result.score)>=Number(result.passing_score)?'Lulus':'Belum lulus' %></strong> · <%= result.status==='expired'?'Waktu habis':'Selesai' %></p></div><h2 class="h4 mb-3">Jawaban Siswa</h2><% items.forEach(item=>{ %><div class="panel p-4 mb-3"><h3 class="h5"><%= item.ordinal %>. <%= item.stem_snapshot %></h3><p class="<%= item.is_correct?'text-success':'text-danger' %>"><%= item.chosen_option_id==null?'Tidak dijawab':item.is_correct?'Benar':'Salah' %></p><ul><% item.options_snapshot.forEach(o=>{ %><li><%= o.body %><% if(String(o.id)===String(item.chosen_option_id)){ %> <strong> — Pilihan siswa</strong><% } %><% if(String(o.id)===String(item.correct_option_id)){ %> <span class="text-success"> — Jawaban benar</span><% } %></li><% }) %></ul></div><% }) %><a href="/admin/results" class="btn btn-outline-dark">Kembali ke Hasil Ujian</a></main><%- include('../partials/footer') %>