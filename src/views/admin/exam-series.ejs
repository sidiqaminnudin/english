<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><%- include('../partials/adminnav') %><h1>Exam Series</h1><% series.forEach(s=>{ %><section class="article-card mb-3"><h2><%= s.title %></h2><form method="post" action="/admin/exam-series/<%= s.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Jumlah soal <input class="form-control" type="number" name="question_count" value="<%= s.question_count %>" min="25" max="200"></label> <label>Durasi <input class="form-control" type="number" name="duration_minutes" value="<%= s.duration_minutes %>" min="1" max="240"></label> <label>KKM <input class="form-control" type="number" name="passing_score" value="<%= s.passing_score %>" min="0" max="100"></label><label class="d-block"><input type="checkbox" name="is_published" <%= s.is_published?'checked':'' %>> Terbitkan</label><button class="btn btn-brand">Simpan</button></form><% if(s.kind==='fundamentals'){ %><form method="post" action="/admin/exam-series/<%= s.id %>/weights" class="mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><p class="small">Bobot modul</p><% (s.modules||[]).forEach(m=>{ %><label>Modul <%= m.module_id %><input class="form-control" type="number" min="1" max="100" name="weight_<%= m.module_id %>" value="<%= m.weight %>"></label><% }) %><button class="btn btn-sm btn-outline-dark mt-2">Simpan bobot</button></form><% } %><form method="post" action="/admin/exam-series/<%= s.id %>/preview" class="mt-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-dark">Preview ujian</button></form></section><% }) %>
<h2>Review Writing</h2><% pending.forEach(i=>{ %><section class="article-card mb-3"><p>Sesi <%= i.run_id %> · siswa <%= i.user_id %></p><h3 class="h5"><%= i.snapshot.stem %></h3><p>Referensi: <%= i.snapshot.model %></p><p>Jawaban: <%= i.answer.text||'(kosong)' %></p><p>Tense: <%= i.answer.focus||'-' %></p><% if(i.ai_json){ %><p>AI provisional: <%= i.ai_json.feedback_id %></p><% } %><form method="post" action="/admin/exam-series/review/<%= i.id %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label>Poin writing (0–3)<input class="form-control" name="points" type="number" min="0" max="3" step="0.25" required></label><label>Tense benar? <select class="form-select" name="tense_points"><option value="">Tidak diubah</option><option value="1">Benar (+1)</option><option value="0">Salah (0)</option></select></label><label class="d-block">Alasan review<textarea class="form-control" name="reason" maxlength="2000" required></textarea></label><button class="btn btn-brand mt-2">Finalisasi jawaban</button></form></section><% }) %></main><%- include('../partials/footer') %>
