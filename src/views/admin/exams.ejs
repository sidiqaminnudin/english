<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="section-kicker">EXAM MANAGER</span><h1>Pengaturan Ujian</h1><p class="muted">Jumlah soal, durasi, dan passing score berlaku pada sesi ujian baru.</p></div><%- include('../partials/adminnav') %><div class="row g-3"><% rows.forEach(m=>{ %><div class="col-lg-6"><div class="panel p-4 h-100"><div class="d-flex justify-content-between align-items-start"><h4><%= m.title %></h4><span class="status-pill <%= m.is_published?'published':'' %>"><%= m.is_published?'Published':'Draft' %></span></div><form action="/admin/exams/<%= m.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-2"><div class="col-4"><label class="form-label small">Soal</label><input class="form-control" type="number" name="question_count" min="1" max="200" value="<%= m.question_count %>" required></div><div class="col-4"><label class="form-label small">Menit</label><input class="form-control" type="number" name="duration_minutes" min="1" max="240" value="<%= m.duration_minutes %>" required></div><div class="col-4"><label class="form-label small">KKM (%)</label><input class="form-control" type="number" name="passing_score" min="0" max="100" value="<%= m.passing_score %>" required></div></div><button type="submit" class="btn btn-brand btn-sm mt-3">Simpan konfigurasi</button></form></div></div><% }) %></div></main><%- include('../partials/footer') %>
