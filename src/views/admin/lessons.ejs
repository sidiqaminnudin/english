<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="section-kicker">CONTENT MANAGER</span><h1>Kelola Materi</h1><p class="muted">Materi awal Pronouns sudah disiapkan dan bisa diperbarui sebagai Markdown.</p></div><%- include('../partials/adminnav') %><div class="d-flex justify-content-end mb-3"><a class="btn btn-brand" href="/admin/lessons/new"><i class="bi bi-plus-circle"></i> Tambah Materi</a></div><div class="panel table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Modul</th><th>Judul Materi</th><th>Status</th><th>Aksi</th></tr></thead><tbody><% lessons.forEach(l=>{ %><tr><td><span class="tag-soft"><%= l.module_title %></span></td><td><strong><%= l.title %></strong><br><small class="muted"><%= l.slug %></small></td><td><span class="status-pill <%= l.is_published?'published':'' %>"><%= l.is_published?'Published':'Draft' %></span></td><td><a href="/admin/lessons/<%= l.id %>/edit" class="btn btn-sm btn-outline-dark">Edit <i class="bi bi-pencil"></i></a></td></tr><% }) %></tbody></table></div></main><%- include('../partials/footer') %>
