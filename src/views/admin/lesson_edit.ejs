<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><a href="/admin/lessons" class="back-link"><i class="bi bi-arrow-left"></i> Kelola materi</a><div class="page-intro mt-3"><span class="section-kicker">CONTENT EDITOR</span><h1>Edit Materi</h1><p class="muted"><%= lesson.module_title %> · Gunakan format Markdown seperti **tebal**, # Judul, dan tabel.</p></div><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><div class="panel p-4"><form action="/admin/lessons/<%= lesson.id %>/edit" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="mb-3"><label class="form-label" for="title">Judul</label><input class="form-control" id="title" name="title" maxlength="160" value="<%= lesson.title %>" required></div><div class="mb-3"><label class="form-label" for="summary">Ringkasan</label><textarea class="form-control" id="summary" name="summary" rows="2"><%= lesson.summary %></textarea></div><div class="mb-3"><label class="form-label" for="body_md">Konten Markdown</label><textarea class="form-control code-editor" id="body_md" name="body_md" rows="22" spellcheck="false"><%= lesson.body_md %></textarea><div class="form-text">HTML mentah tidak dirender demi keamanan. Gunakan Markdown.</div></div><div class="form-check form-switch mb-4"><input class="form-check-input" type="checkbox" id="is_published" name="is_published" <%= lesson.is_published?'checked':'' %>><label class="form-check-label" for="is_published">Publikasikan materi</label></div><button type="submit" class="btn btn-brand">Simpan Perubahan <i class="bi bi-check-lg"></i></button><a href="/admin/lessons" class="btn btn-outline-dark ms-2">Batal</a></form></div></main><%- include('../partials/footer') %>
