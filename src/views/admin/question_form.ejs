<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><a href="/admin/questions" class="back-link"><i class="bi bi-arrow-left"></i> Bank Soal</a><div class="page-intro mt-3"><span class="section-kicker">QUESTION EDITOR</span><h1><%= editing?'Edit Soal':'Tambah Soal' %></h1><p class="muted">Pastikan hanya ada satu jawaban paling tepat. Simpan penjelasan agar siswa memahami alasannya.</p></div><% if(error){ %><div class="alert alert-danger"><%= error %></div><% } %><div class="panel p-4"><form action="/admin/questions/<%= editing?question.id+'/edit':'new' %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><div class="row g-3"><div class="col-md-6"><label for="module_id" class="form-label">Modul</label><select name="module_id" id="module_id" class="form-select" required><option value="">Pilih modul</option><% modules.forEach(m=>{ %><option value="<%= m.id %>" <%= Number(question.module_id)===Number(m.id)?'selected':'' %>><%= m.title %></option><% }) %></select></div><div class="col-md-6"><label for="lesson_id" class="form-label">Submateri</label><select name="lesson_id" id="lesson_id" class="form-select"><option value="">Umum (seluruh modul)</option><% lessons.forEach(l=>{ %><option data-module-id="<%= l.module_id %>" value="<%= l.id %>" <%= Number(question.lesson_id)===Number(l.id)?'selected':'' %>><%= l.title %></option><% }) %></select></div><div class="col-md-4"><label for="difficulty" class="form-label">Kesulitan</label><select name="difficulty" id="difficulty" class="form-select"><% ['easy','medium','hard'].forEach(d=>{ %><option <%= question.difficulty===d?'selected':'' %> value="<%= d %>"><%= d %></option><% }) %></select></div><div class="col-md-8"><label for="stem" class="form-label">Pertanyaan</label><textarea id="stem" name="stem" class="form-control" rows="2" required><%= question.stem %></textarea></div><div class="col-12"><h4 class="h6 mt-3">Empat pilihan jawaban</h4><p class="small muted">Pilih radio di sisi kanan pilihan yang benar.</p></div><% for(let i=0;i<4;i++){ %><div class="col-12"><div class="input-group"><span class="input-group-text"><%= String.fromCharCode(65+i) %></span><input class="form-control" name="option_<%= i %>" maxlength="500" required value="<%= (question.options&&question.options[i])||'' %>" aria-label="Pilihan <%= String.fromCharCode(65+i) %>"><span class="input-group-text"><input type="radio" name="correct_index" value="<%= i %>" required <%= Number(question.correct_index)===i?'checked':'' %> aria-label="Pilihan <%= String.fromCharCode(65+i) %> benar"></span></div></div><% } %><div class="col-12"><label for="explanation" class="form-label">Pembahasan</label><textarea id="explanation" class="form-control" name="explanation" rows="4" required><%= question.explanation %></textarea></div><div class="col-12"><div class="form-check form-switch"><input id="is_active" class="form-check-input" name="is_active" type="checkbox" <%= question.is_active?'checked':'' %>><label for="is_active" class="form-check-label">Aktifkan soal pada bank</label></div></div><div class="col-12"><button class="btn btn-brand" type="submit">Simpan Soal <i class="bi bi-check-lg"></i></button><a class="btn btn-outline-dark ms-2" href="/admin/questions">Batal</a></div></div></form></div></main><script src="/js/admin.js" defer></script><%- include('../partials/footer') %>
