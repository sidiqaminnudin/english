<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="section-kicker">ACCOUNT MANAGER</span><h1>Akun Siswa</h1><p class="muted">Username dapat dilihat admin. Password lama tidak dapat dibuka karena tersimpan aman sebagai hash; gunakan reset untuk membuat password baru.</p></div><%- include('../partials/adminnav') %><% if(resetPassword){ %><div class="alert alert-warning"><strong>Password baru untuk <%= resetPassword.username %>:</strong> <code class="fs-5"><%= resetPassword.password %></code><br><small>Simpan dan sampaikan kepada siswa sekarang. Password ini hanya ditampilkan sekali.</small></div><% } %><form class="row g-2 mb-3" method="get"><div class="col-md-6"><label class="visually-hidden" for="accountSearch">Cari siswa</label><input id="accountSearch" class="form-control" name="search" value="<%= search %>" placeholder="Cari username atau nama siswa"></div><div class="col-auto"><button class="btn btn-outline-dark">Cari</button></div></form><p class="muted small d-md-none mb-2">Geser tabel ke samping untuk melihat semua kolom.</p><div class="panel admin-table-scroll" role="region" aria-label="Tabel akun siswa" tabindex="0"><table class="table align-middle mb-0"><thead><tr><th>Username</th><th>Nama</th><th>Status</th><th>Aktivitas</th><th>Reset Password</th></tr></thead><tbody><% if(!students.length){ %><tr><td colspan="5" class="text-center py-4 muted">Belum ada akun siswa.</td></tr><% } %><% students.forEach(s=>{ %><tr><td><code><%= s.username %></code></td><td><strong><%= s.full_name %></strong><br><small class="muted">Daftar <%= new Date(s.created_at).toLocaleDateString('id-ID') %></small></td><td><span class="status-pill <%= s.is_active?'published':'' %>"><%= s.is_active?'Aktif':'Nonaktif' %></span></td><td><%= s.attempt_count %> sesi<% if(s.last_activity){ %><br><small class="muted">Terakhir <%= new Date(s.last_activity).toLocaleDateString('id-ID') %></small><% } %></td><td><form method="post" action="/admin/accounts/<%= s.id %>/reset-password" class="d-flex gap-2"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="form-control form-control-sm" name="password" minlength="10" maxlength="128" placeholder="Password baru" required><button class="btn btn-sm btn-outline-dark" type="submit">Buat</button></form></td></tr><% }) %></tbody></table></div></main><%- include('../partials/footer') %>