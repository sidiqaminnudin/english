<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="section-kicker">STUDENT RESULTS</span><h1>Hasil Ujian Siswa</h1><p class="muted">Semua sesi ujian dan latihan siswa yang telah selesai, dari yang terbaru.</p></div><%- include('../partials/adminnav') %><p class="muted small d-md-none mb-2">Geser tabel ke samping untuk melihat seluruh hasil dan tombol detail.</p><form class="row g-2 mb-3" method="get"><div class="col-md-6"><label class="visually-hidden" for="resultSearch">Cari siswa</label><input id="resultSearch" class="form-control" name="search" value="<%= search %>" placeholder="Cari username atau nama siswa"></div><div class="col-auto"><button class="btn btn-outline-dark">Cari</button></div></form><div class="panel admin-table-scroll" role="region" aria-label="Tabel hasil ujian" tabindex="0"><table class="table table-hover align-middle mb-0"><thead><tr><th>Siswa</th><th>Modul</th><th>Jenis</th><th>Tanggal</th><th>Nilai</th><th>Benar / Soal</th><th>Status</th><th>Detail</th></tr></thead><tbody><% if(!results.length){ %><tr><td colspan="8" class="text-center py-4 muted">Belum ada hasil ujian.</td></tr><% } %><% results.forEach(r=>{ %><tr><td><strong><%= r.full_name %></strong><br><small class="muted"><%= r.username %></small></td><td><span class="tag-soft"><%= r.module_title %></span></td><td><span class="tag-soft"><%= r.mode==='exam'?'Exam':'Latihan' %></span></td><td class="small"><%= r.submitted_at? new Date(r.submitted_at).toLocaleString('id-ID',{dateStyle:'short',timeStyle:'short'}) : '—' %></td><td><strong class="<%= Number(r.score)>=Number(r.passing_score)?'text-success':'text-danger' %>"><%= r.score!=null?Number(r.score).toFixed(0):'—' %></strong></td><td><%= r.correct_count!=null?r.correct_count:'—' %> / <%= r.question_count %></td><td><%= r.status==='expired'?'Waktu habis':'Selesai' %></td><td><a href="/admin/results/<%= r.id %>" class="btn btn-sm btn-outline-dark">Lihat</a></td></tr><% }) %></tbody></table></div><% if(page>1||results.length>=50){ %> <% /* Navigation remains available on the last page. */ %><div class="d-flex justify-content-end gap-2 mt-3"><% if(page>1){ %><a href="?page=<%= page-1 %>&search=<%= encodeURIComponent(search) %>" class="btn btn-sm btn-outline-dark">&laquo; Sebelumnya</a><% } %><% if(results.length>=50){ %><a href="?page=<%= page+1 %>&search=<%= encodeURIComponent(search) %>" class="btn btn-sm btn-outline-dark">Selanjutnya &raquo;</a><% } %></div><% } %></main><%- include('../partials/footer') %>