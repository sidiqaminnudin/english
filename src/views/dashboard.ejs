<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="section-kicker">STUDENT DASHBOARD</span><h1>Halo, <%= user.full_name.split(' ')[0] %> <i class="bi bi-emoji-smile text-warning"></i></h1><p class="muted">Pantau progres dan lanjutkan belajar dari modul favoritmu.</p></div><div class="row g-3 mb-5"><div class="col-md-4"><div class="stat-card"><div class="stat-icon"><i class="bi bi-book-half"></i></div><strong><%= stats.lessons %></strong><span>Materi dibuka</span></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-icon"><i class="bi bi-check2-circle"></i></div><strong><%= stats.completed %></strong><span>Sesi selesai</span></div></div><div class="col-md-4"><div class="stat-card"><div class="stat-icon"><i class="bi bi-graph-up-arrow"></i></div><strong><%= stats.avg_score??'0' %></strong><span>Rata-rata nilai exam</span></div></div></div><div class="row g-4"><div class="col-lg-7"><div class="section-kicker">YOUR PROGRESS</div><h2 class="h4 mb-3 mt-1">Aktivitas terbaru</h2><div class="panel"><% if(!attempts.length){ %><div class="empty-state"><i class="bi bi-clipboard-check"></i><h5>Belum ada aktivitas</h5><p class="muted">Mulailah dengan latihan Pronouns.</p></div><% }else{attempts.forEach(a=>{ %><div class="activity-row"><span class="activity-icon"><i class="bi bi-<%= a.mode==='exam'?'award':'lightning-charge' %>"></i></span><span class="flex-grow-1"><strong><%= a.module_title %> · <%= a.mode==='exam'?'Exam':'Practice' %></strong><small><%= new Date(a.started_at).toLocaleString('id-ID',{dateStyle:'medium',timeStyle:'short'}) %> · <%= a.status==='in_progress'?'Sedang dikerjakan':a.status==='expired'?'Waktu habis':'Selesai' %></small></span><% if(a.status==='in_progress'){ %><a class="btn btn-sm btn-outline-dark" href="/attempts/<%= a.id %>/take">Lanjutkan</a><% }else{ %><a class="btn btn-sm btn-outline-dark" href="/attempts/<%= a.id %>/result"><%= a.score %> <i class="bi bi-arrow-up-right"></i></a><% } %></div><% })} %></div><a href="/history" class="text-link d-inline-block mt-3">Lihat semua riwayat <i class="bi bi-arrow-right"></i></a></div><div class="col-lg-5"><div class="sidebar-cta"><span class="eyebrow">CONTINUE LEARNING</span><h3 class="mt-3">Pronouns</h3><p>7 submateri dari subject sampai interrogative pronouns. Kuasai konsepnya sedikit demi sedikit.</p><a href="/learn/pronouns" class="btn btn-light w-100 mb-2">Baca Materi</a><a href="/practice/pronouns" class="btn btn-brand w-100">Mulai Latihan</a><hr><a href="/exam/pronouns" class="sidebar-link">Kerjakan Exam <i class="bi bi-arrow-right"></i></a></div></div></div></main><%- include('partials/footer') %>
