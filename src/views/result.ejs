<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><div class="row justify-content-center"><div class="col-xl-9"><a class="back-link" href="/dashboard"><i class="bi bi-arrow-left"></i> Dashboard</a><div class="result-hero mt-3"><span class="eyebrow"><%= attempt.mode==='exam'?'EXAM RESULTS':'PRACTICE RESULTS' %></span><h1 class="mt-3"><%= attempt.mode==='exam'?(Number(attempt.score)>=Number(attempt.passing_score)?'Selamat, kamu lulus!':'Terus semangat belajar!'):'Latihan selesai!' %></h1><p><%= attempt.module_title %> · <%= attempt.status==='expired'?'Waktu habis':'Selesai' %></p><div class="result-score"><strong><%= Number(attempt.score).toFixed(0) %></strong><span>/100</span></div><div class="d-flex justify-content-center flex-wrap gap-4 mt-3"><span><i class="bi bi-check-circle"></i> <%= attempt.correct_count %> Benar</span><span><i class="bi bi-card-list"></i> <%= attempt.question_count %> Soal</span><span><i class="bi bi-flag"></i> Target <%= attempt.passing_score %></span></div><div class="d-flex justify-content-center flex-wrap gap-2 mt-4"><a href="<%= attempt.module_id ? '/practice/'+attempt.module_slug : '/courses' %>" class="btn btn-light">Latihan Lagi</a><a href="/exam/<%= attempt.module_slug %>" class="btn btn-outline-light">Exam Lagi</a></div></div><div class="d-flex justify-content-between align-items-center mt-5 mb-3"><h2 class="h4 mb-0">Pembahasan Jawaban</h2><span class="muted small"><%= items.length %> soal</span></div><% items.forEach((item,i)=>{ %><div class="review-card"><div class="d-flex justify-content-between align-items-center mb-3"><span class="tag-soft">SOAL <%= i+1 %></span><span class="review-state <%= item.is_correct?'good':'bad' %>"><i class="bi bi-<%= item.is_correct?'check-circle':'x-circle' %>"></i> <%= item.is_correct?'Benar':'Salah' %></span></div><h4><%= item.stem_snapshot %></h4><div class="review-options"><% item.options_snapshot.forEach((o,j)=>{ %><div class="review-option <%= String(o.id)===String(item.correct_option_id)?'correct':'' %> <%= String(o.id)===String(item.chosen_option_id)&&!item.is_correct?'wrong':'' %>"><span><%= String.fromCharCode(65+j) %></span> <%= o.body %> <% if(String(o.id)===String(item.correct_option_id)){ %><i class="bi bi-check-circle-fill ms-auto" title="Jawaban benar"></i><% }else if(String(o.id)===String(item.chosen_option_id)){ %><small class="ms-auto">Jawabanmu</small><% } %></div><% }) %></div><div class="explanation"><i class="bi bi-lightbulb-fill"></i><div><strong>Pembahasan</strong><p class="mb-0"><%= item.explanation_snapshot %></p></div></div></div><% }) %></div></div></main><%- include('partials/footer') %>
