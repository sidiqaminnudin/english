<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><a href="/courses" class="back-link"><i class="bi bi-arrow-left"></i> Kurikulum</a><div class="module-banner mt-4"><div><span class="eyebrow">ENGLISH FOUNDATIONS · BEGINNER</span><h1 class="mt-2"><%= module.title %></h1><p><%= module.description %></p><div class="d-flex flex-wrap gap-2 mt-4"><span class="mini-tag"><i class="bi bi-journals"></i> <%= lessons.length %> Lessons</span><span class="mini-tag"><i class="bi bi-lightning"></i> Interactive practice</span></div></div><div class="module-art"><i class="bi bi-chat-square-quote-fill"></i></div></div><div class="row g-4 mt-3"><div class="col-lg-8"><div class="d-flex justify-content-between align-items-center mb-3"><h2 class="h4 m-0">Daftar Submateri</h2><span class="muted small">Baca sesuai urutan</span></div><div class="lesson-stack"><% lessons.forEach((l,i)=>{ %><a class="lesson-row" href="/learn/<%= module.slug %>/<%= l.slug %>"><span class="lesson-number"><%= String(i+1).padStart(2,'0') %></span><span class="flex-grow-1"><strong><%= l.title %></strong><small><%= l.summary %></small></span><i class="bi bi-arrow-right"></i></a><% }) %></div></div><div class="col-lg-4"><div class="sidebar-cta"><div class="sidebar-icon"><i class="bi bi-lightning-charge"></i></div><h4>Sudah paham materinya?</h4><p>Latih pemahaman dengan soal acak dan evaluasi hasilnya.</p><a href="<%= user?'/practice/'+module.slug:'/login?next='+encodeURIComponent('/practice/'+module.slug) %>" class="btn btn-brand w-100 mb-2">Mulai Latihan</a><a href="<%= user?'/exam/'+module.slug:'/login?next='+encodeURIComponent('/exam/'+module.slug) %>" class="btn btn-outline-dark w-100">Ikuti Exam</a></div></div></div></main><%- include('partials/footer') %>
