<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><div class="page-intro"><a href="/courses" class="back-link"><i class="bi bi-arrow-left"></i> Semua kursus</a><span class="section-kicker d-block mt-3">COURSE OVERVIEW</span><h1><%= course.title %></h1><p class="muted"><%= course.description %></p></div><div class="row g-3"><% modules.forEach((m,i)=>{ %><div class="col-lg-6"><a class="lesson-row" href="/learn/<%= m.slug %>"><span class="lesson-number"><%= String(i+1).padStart(2,'0') %></span><span class="flex-grow-1"><strong><%= m.title %></strong><small><%= m.lesson_count %> submateri · <%= m.question_count %> soal</small></span><i class="bi bi-arrow-up-right text-dark"></i></a></div><% }) %></div></main><%- include('partials/footer') %>
