<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="section-kicker">YOUR LEARNING HISTORY</span><h1>Riwayat Latihan & Exam</h1><p class="muted">Semua sesi tersimpan pada akunmu.</p></div><div class="panel table-responsive"><table class="table table-hover align-middle mb-0"><thead><tr><th>Materi</th><th>Jenis</th><th>Mulai</th><th>Status</th><th>Nilai</th><th>Detail</th></tr></thead><tbody><% if(!attempts.length){ %><tr><td colspan="6" class="py-4 text-center muted">Belum ada sesi.</td></tr><% } %><% attempts.forEach(a=>{ %><tr><td class="fw-semibold"><%= a.module_title %></td><td><span class="tag-soft"><%= a.mode %></span></td><td class="small"><%= new Date(a.started_at).toLocaleString('id-ID',{dateStyle:'short',timeStyle:'short'}) %></td><td><%= a.status==='in_progress'?'Berlangsung':a.status==='expired'?'Expired':'Selesai' %></td><td><strong><%= a.score??'—' %></strong></td><td><a href="/attempts/<%= a.id %>/<%= a.status==='in_progress'?'take':'result' %>" class="btn btn-sm btn-outline-dark"><%= a.status==='in_progress'?'Lanjutkan':'Lihat hasil' %></a></td></tr><% }) %></tbody></table></div></main><%- include('partials/footer') %>
