<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><h1>Hasil Ujian</h1><% const total=items.reduce((s,i)=>s+Number(i.objective_points)+Number(i.writing_points||0),0); %><p>Skor <%= run.status==='final'?'final':'sementara' %>: <%= total.toFixed(2) %>/100</p><% if(run.status==='final'){ %><p><%= total>=run.config.passing_score?'Lulus':'Belum lulus' %> · KKM <%= run.config.passing_score %></p><% }else{ %><form method="post" action="/exams/run/<%= run.id %>/ai"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-dark">Minta feedback AI provisional</button></form><% } %><% if(run.status==='pending_review'){ %><div class="alert alert-warning">Nilai Writing masih menunggu review admin. Belum ada status lulus/gagal final.</div><% }else{ %><div class="alert alert-info">Hasil final tersedia. Listening diberi 4 poin per jawaban benar.</div><% } %><div class="list-group"><% items.forEach(i=>{ %><div class="list-group-item"><strong><%= i.ordinal %>. <%= i.snapshot.stem %></strong><p>Jawaban: <%= i.kind==='writing'?(i.answer.text||'(kosong)'):(i.snapshot.options.find(o=>o.id===i.answer.option)?.body||'(kosong)') %></p><p><%= i.snapshot.explanation %></p><% if(i.kind==='listening'){ %><details><summary>Transkrip dan sumber</summary><p><%= i.snapshot.transcript %></p><p><%= i.snapshot.credit %></p></details><% } %><% if(i.ai_json){ %><p>AI provisional: <%= (i.ai_json.overall_score*3/100).toFixed(2) %>/3 — <%= i.ai_json.feedback_id %></p><p>Saran: <%= i.ai_json.corrected_english %></p><% }else if(i.kind==='writing'&&i.review_status==='pending'){ %><p>Feedback AI belum tersedia. Review manual tetap dapat dilakukan.</p><% } %><% if(i.review_reason){ %><p>Review admin: <%= i.review_reason %></p><% } %> — poin objektif: <%= i.objective_points %><% if(i.writing_points!==null){ %>, poin writing: <%= i.writing_points %><% } %></div><% }) %></div></main><%- include('partials/footer') %>
