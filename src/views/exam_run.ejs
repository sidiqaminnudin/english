<%- include('partials/head') %><%- include('partials/nav') %>
<main class="container page-pad"><h1><%= run.config.title %></h1><p>Batas waktu: <time><%= new Date(run.deadline_at).toLocaleString('id-ID') %></time>. Jawaban setelah batas waktu tidak diterima. Gunakan Simpan secara berkala.</p>
<% if(run.status!=='in_progress'){ %><a href="/exams/run/<%= run.id %>/result">Lihat hasil</a><% }else{ %>
<form method="post" action="/exams/run/<%= run.id %>" data-exam-deadline="<%= new Date(run.deadline_at).toISOString() %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
<% items.forEach(i=>{ %><section class="article-card mb-3"><h2 class="h5"><%= i.ordinal %>. <%= i.snapshot.stem %></h2>
<% if(i.kind==='writing'){ %><label for="focus-<%= i.id %>">Pilih tense dahulu</label><select id="focus-<%= i.id %>" class="form-select mb-3" name="focus_<%= i.id %>"><option value="">Pilih tense</option><% ['simple-present','simple-past','simple-future','present-continuous','past-continuous','future-continuous','present-perfect'].forEach(f=>{ %><option value="<%= f %>" <%= i.answer.focus===f?'selected':'' %>><%= f %></option><% }) %></select><label for="text-<%= i.id %>">Tuliskan kalimat Inggris (maksimal 2000 karakter)</label><textarea class="form-control" id="text-<%= i.id %>" name="text_<%= i.id %>" maxlength="2000" rows="3"><%= i.answer.text||'' %></textarea>
<% }else{ %><% if(i.kind==='listening'){ %><audio controls preload="none" src="<%= i.snapshot.audio %>">Audio tidak didukung.</audio><p class="small">Sumber: <%= i.snapshot.source_type %> — <%= i.snapshot.credit %></p><% } %>
<% i.snapshot.options.forEach(o=>{ %><label class="d-block border rounded p-3 mb-2"><input type="radio" name="option_<%= i.id %>" value="<%= o.id %>" <%= i.answer.option===o.id?'checked':'' %>> <%= o.body %></label><% }) %><% } %></section><% }) %>
<button class="btn btn-outline-dark" name="action" value="save">Simpan jawaban</button> <button class="btn btn-brand" name="action" value="submit">Kumpulkan ujian</button></form><script src="/js/exam-series.js" defer></script><% } %></main><%- include('partials/footer') %>
