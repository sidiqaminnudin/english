<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><span class="eyebrow">LISTENING PRACTICE · <%= run.level %></span><h1 class="h2 fw-bold mt-2"><%= run.track_title %></h1><p class="muted">Dengarkan audio terlebih dahulu. Atur kecepatannya jika perlu, lalu jawab semua pertanyaan.</p>
<div class="question-panel mb-4"><label class="form-label fw-bold" for="trackAudio"><i class="bi bi-volume-up me-2"></i>Audio Listening</label><audio id="trackAudio" controls preload="metadata" src="<%= run.audio_path %>" class="w-100" aria-label="Audio listening"></audio><div class="d-flex align-items-center gap-2 flex-wrap mt-2"><span class="small muted">Kecepatan:</span><button type="button" class="btn btn-sm btn-outline-secondary" data-audio-speed="0.8">0.8×</button><button type="button" class="btn btn-sm btn-outline-secondary" data-audio-speed="1">1×</button><button type="button" class="btn btn-sm btn-outline-secondary" data-audio-speed="1.2">1.2×</button></div></div>
<form method="post" action="/listening/run/<%= run.id %>/submit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% items.forEach(item=>{ %><div class="review-card"><h2 class="h5 fw-bold"><%= item.ordinal %>. <%= item.question_snapshot %></h2><div class="answer-options"><% item.options_snapshot.forEach((option,i)=>{ %><label class="answer-option"><input type="radio" name="q<%= item.ordinal %>" value="<%= i %>" <%= i===0?'required':'' %>><span class="answer-letter"><%= String.fromCharCode(65+i) %></span><span class="answer-body"><%= option %></span></label><% }) %></div></div><% }) %><button class="btn btn-brand btn-lg" type="submit">Selesai dan lihat nilai <i class="bi bi-check2-circle"></i></button></form></main>
<script src="/js/listening.js" defer></script><%- include('../partials/footer') %>
