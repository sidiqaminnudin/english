<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><span class="eyebrow">LISTENING RESULT</span><h1 class="h2 fw-bold mt-2"><%= run.track_title %></h1><div class="result-hero my-4"><p class="mb-1">Nilai Listening</p><div class="result-score"><strong><%= Number(run.score||0).toFixed(0) %></strong><span>/100</span></div><p class="mt-3 mb-0"><%= run.correct_count %> / <%= items.length %> jawaban benar</p></div>
<div class="question-panel mb-4"><h2 class="h4 fw-bold">Dengarkan ulang & baca transkrip</h2><audio controls preload="metadata" src="<%= run.audio_path %>" class="w-100 my-2"></audio><div class="listening-transcript"><%= run.transcript %></div><p class="small muted mt-3 mb-0">Audio source: <%= run.source_credit %></p></div>
<% items.forEach(item=>{ %><div class="review-card"><h3 class="h5 fw-bold"><%= item.ordinal %>. <%= item.question_snapshot %></h3><p class="small <%= item.is_correct?'text-success':'text-danger' %>"><%= item.is_correct?'Benar':'Belum tepat' %></p><p>Jawabanmu: <strong><%= item.chosen_index===null?'Tidak dijawab':item.options_snapshot[item.chosen_index] %></strong></p><p>Jawaban benar: <strong><%= item.options_snapshot[item.correct_index] %></strong></p><div class="explanation"><i class="bi bi-lightbulb"></i><div><%= item.explanation_snapshot %></div></div></div><% }) %>
<a href="/listening" class="btn btn-brand">Listening lainnya <i class="bi bi-arrow-right"></i></a></main><%- include('../partials/footer') %>
