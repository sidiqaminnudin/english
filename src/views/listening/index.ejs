<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><div class="page-intro"><span class="eyebrow">LISTEN & UNDERSTAND</span><h1>Listening Sessions</h1><p class="muted">Dengarkan percakapan atau cerita singkat lalu jawab pertanyaannya. Dengarkan audio percakapan, lalu jawab pertanyaan. Transkrip tersedia setelah sesi selesai. Sumber rekaman ditampilkan pada hasil.</p></div>
<div class="row g-3"><% tracks.forEach(t=>{ %><div class="col-md-6 col-lg-4"><div class="course-card h-100"><div class="d-flex justify-content-between"><span class="course-icon"><i class="bi bi-headphones"></i></span><span class="tag-soft"><%= t.level %></span></div><h3 class="mt-3"><%= t.title %></h3><p><%= t.topic %> · <%= t.question_count %> pertanyaan</p><p class="small muted">Audio + quiz + transcript setelah selesai</p><form action="/listening/<%= t.slug %>/start" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if(user){ %><label class="small fw-semibold" for="count-<%= t.id %>">Jumlah soal</label><select id="count-<%= t.id %>" name="question_count" class="form-select mb-2"><option value="4">4 soal</option><option value="8" <%= t.question_count>=8?'selected':'disabled' %>>8 soal</option><option value="12" <%= t.question_count>=12?'selected':'disabled' %>>12 soal</option></select><button class="btn btn-brand w-100">Mulai Listening <i class="bi bi-play-fill"></i></button><% }else{ %><a class="btn btn-brand w-100" href="/login?next=%2Flistening">Masuk untuk mulai</a><% } %></form></div></div><% }) %></div><% if(!tracks.length){ %><div class="alert alert-warning">Audio belum di-seed. Jalankan npm run db:seed:v12.</div><% } %></main><%- include('../partials/footer') %>
