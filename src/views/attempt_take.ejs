<%- include('partials/head') %><%- include('partials/nav') %><main class="container page-pad"><div class="row justify-content-center"><div class="col-xl-9"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><span class="section-kicker"><%= attempt.mode==='exam'?'TIMED EXAM':'PRACTICE SESSION' %></span><h1 class="h3 mt-2 mb-0"><%= attempt.module_title %></h1></div><div class="timer-pill <%= attempt.mode==='practice'?'timer-off':'' %>" id="examTimer" data-deadline="<%= attempt.mode==='exam'?new Date(new Date(attempt.started_at).getTime()+Number(attempt.duration_minutes)*60000).toISOString():'' %>"><i class="bi bi-clock"></i> <span id="timerValue"><%= attempt.mode==='exam'?'--:--':'Tanpa batas waktu' %></span></div></div>
<div id="assessment" data-attempt-id="<%= attempt.id %>" data-mode="<%= attempt.mode %>" data-csrf="<%= csrfToken %>"><div class="d-flex justify-content-between small muted mb-2"><span id="questionCounter">Question 1 / <%= items.length %></span><span id="answeredCounter">0 / <%= items.length %> terjawab</span></div><div class="progress-track mb-4"><span id="questionProgress"></span></div>
<% items.forEach((item,i)=>{ %><section class="question-panel <%= i===0?'':'d-none' %>" data-item-id="<%= item.id %>" data-index="<%= i %>" data-saved="<%= item.chosen_option_id||'' %>"><div class="d-flex justify-content-between align-items-center mb-3"><span class="tag-soft">QUESTION <%= String(i+1).padStart(2,'0') %></span><span class="muted small"><%= attempt.mode==='exam'?'Jawaban disembunyikan':'Pembahasan langsung' %></span></div><h2 class="quiz-question"><%= item.stem_snapshot %></h2><div class="answer-options" role="group" aria-label="Pilihan jawaban untuk soal <%= i+1 %>"><% item.options_snapshot.forEach((opt,j)=>{ %><label class="answer-option <%= String(item.chosen_option_id||'')===String(opt.id)?'is-selected':'' %>"><input type="radio" name="answer-<%= item.id %>" value="<%= opt.id %>" <%= String(item.chosen_option_id||'')===String(opt.id)?'checked':'' %>><span class="answer-letter"><%= String.fromCharCode(65+j) %></span><span class="answer-body"><%= opt.body %></span><i class="bi bi-circle answer-check"></i></label><% }) %></div><div class="answer-feedback" aria-live="polite"></div></section><% }) %>
<div class="quiz-bottom"><div class="d-flex flex-wrap gap-2 justify-content-between align-items-center"><button type="button" id="prevQuestion" class="btn btn-outline-dark"><i class="bi bi-arrow-left"></i> Sebelumnya</button><div class="d-flex flex-wrap gap-2"><button type="button" id="nextQuestion" class="btn btn-brand">Berikutnya <i class="bi bi-arrow-right"></i></button><form action="/attempts/<%= attempt.id %>/submit" method="post" id="submitAttempt"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button id="finishButton" class="btn btn-dark" type="submit">Selesaikan <i class="bi bi-check2-circle"></i></button></form></div></div><p class="muted small mt-3 mb-0" id="saveStatus">Pilihan akan tersimpan otomatis.</p></div>
</div></div></div></main><script src="/js/attempt.js" defer></script><%- include('partials/footer') %>
