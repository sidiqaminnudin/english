<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container page-pad"><span class="eyebrow">PRACTICE COMPLETED</span><h1 class="h2 fw-bold mt-2">Hasil latihan terjemahan</h1>
<% const focusCorrect=items.filter(i=>i.tense_correct).length; const accepted=items.filter(i=>i.sentence_verdict==='accepted').length;const pending=items.filter(i=>i.sentence_verdict==='pending').length; %>
<div class="row g-3 my-3"><div class="col-4"><div class="stat-card"><strong><%= focusCorrect %>/<%= items.length %></strong><span>Tense tepat</span></div></div><div class="col-4"><div class="stat-card"><strong><%= accepted %></strong><span>Kalimat diterima</span></div></div><div class="col-4"><div class="stat-card"><strong><%= pending %></strong><span>Butuh review</span></div></div></div>
<div class="alert alert-info">Skor kalimat bukan nilai final selama masih ada jawaban yang perlu ditinjau. Jawaban yang tidak sama persis dengan contoh <strong>tidak otomatis salah</strong>.</div>
<% items.forEach(item=>{ %><div class="review-card"><div class="d-flex justify-content-between flex-wrap gap-2"><strong><%= item.ordinal %>. <%= item.prompt_snapshot %></strong><span class="status-pill <%= item.sentence_verdict==='accepted'?'published':'' %>"><%= item.sentence_verdict %></span></div><p class="mb-1 mt-2"><span class="muted">Tense pilihan:</span> <%= focusLabels[item.chosen_focus]||'-' %> <span class="<%= item.tense_correct?'text-success':'text-danger' %>">(<%= item.tense_correct?'tepat':'perlu revisi' %>)</span></p><p class="mb-1"><span class="muted">Jawaban:</span> <%= item.answer_text %></p><p class="mb-0"><span class="muted">Contoh:</span> <%= item.model_snapshot %></p></div><% }) %>
<div class="d-flex gap-2"><a class="btn btn-brand" href="/translation">Latihan lagi</a><a class="btn btn-outline-secondary" href="/translation/history">Riwayat</a></div></main><%- include('../partials/footer') %>
