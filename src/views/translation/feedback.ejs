<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container page-pad"><div class="row justify-content-center"><div class="col-lg-8"><span class="eyebrow">FEEDBACK · QUESTION <%= item.ordinal %></span><h1 class="h2 fw-bold mt-2 mb-4">Pembahasan terjemahan</h1><div class="review-card">
 <p class="mini-label mb-1">BAHASA INDONESIA</p><h2 class="h5 fw-bold"><%= item.prompt_snapshot %></h2><hr><p class="mini-label mb-1">TENSE / STRUKTUR</p><p class="mb-1">Pilihanmu: <strong><%= focusLabels[item.chosen_focus]||item.chosen_focus %></strong></p><p class="small <%= item.tense_correct?'text-success':'text-danger' %>"><%= item.tense_correct?'Tense/struktur tepat':'Periksa pilihan tense/struktur' %> · Rujukan: <%= focusLabels[item.focus_snapshot] %></p>
 <p class="mini-label mb-1 mt-4">JAWABANMU</p><p class="lead"><%= item.answer_text %></p><p><span class="status-pill <%= item.sentence_verdict==='accepted'?'published':'' %>"><%= item.sentence_verdict==='accepted'?'Cocok dengan contoh jawaban':item.sentence_verdict==='rejected'?'Perlu diperbaiki':'Menunggu review kalimat alternatif' %></span></p>
 <div class="explanation"><i class="bi bi-lightbulb"></i><div><strong>Contoh jawaban yang dianjurkan</strong><p class="mb-2"><%= item.model_snapshot %></p><small><%= item.explanation_snapshot %></small></div></div>
 </div><div class="d-flex flex-wrap gap-2"><% if(run.status==='submitted'){ %><a class="btn btn-brand" href="/translation/run/<%= run.id %>/result">Lihat rangkuman</a><% }else{ %><a class="btn btn-brand" href="/translation/run/<%= run.id %>">Pertanyaan berikutnya <i class="bi bi-arrow-right"></i></a><% } %><a class="btn btn-outline-secondary" href="/translation">Kembali ke latihan</a></div>
 </div></div></main><%- include('../partials/footer') %>
