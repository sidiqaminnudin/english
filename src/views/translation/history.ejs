<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><span class="eyebrow">MY PROGRESS</span><h1 class="h2 fw-bold mb-4">Riwayat Terjemahan</h1><div class="panel table-responsive"><table class="table align-middle"><thead><tr><th>Sesi</th><th>Tanggal</th><th>Fokus</th><th>Tense tepat</th><th>Review pending</th></tr></thead><tbody><% runs.forEach(r=>{ %><tr><td><a class="text-link" href="/translation/run/<%= r.id %>/<%= r.status==='submitted'?'result':'' %>">#<%= r.id %></a></td><td><%= new Date(r.started_at).toLocaleString('id-ID') %></td><td><%= focusLabels[r.focus_filter]||'Campuran' %></td><td><%= r.focus_correct %>/<%= r.total %></td><td><%= r.pending %></td></tr><% }) %></tbody></table><% if(!runs.length){ %><p class="p-4 muted">Belum ada sesi latihan.</p><% } %></div></main><%- include('../partials/footer') %>
