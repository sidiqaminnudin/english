<%- include('../partials/head') %><%- include('../partials/nav') %><main class="container page-pad"><h1 class="h2 fw-bold">Review jawaban terjemahan</h1><p class="muted">Tinjau jawaban alternatif yang tidak cocok dengan contoh tetapi mungkin benar. Jangan menolak hanya karena pilihan kata atau susunan berbeda.</p>
<% rows.forEach(r=>{ %><div class="review-card"><div class="d-flex justify-content-between flex-wrap"><strong><%= r.username %> · <%= r.prompt_snapshot %></strong><small class="muted">#<%= r.id %></small></div><p class="mt-2 mb-1">Grammar: <%= focusLabels[r.chosen_focus] %> · Target: <%= focusLabels[r.focus_snapshot] %></p><p><strong>Jawaban siswa:</strong> <%= r.answer_text %></p><p class="muted">Contoh: <%= r.model_snapshot %></p><form class="d-flex gap-2" action="/admin/translation-review/<%= r.id %>" method="post"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button name="verdict" value="accepted" class="btn btn-sm btn-success">Terima</button><button name="verdict" value="rejected" class="btn btn-sm btn-outline-danger">Perlu perbaikan</button></form></div><% }) %><% if(!rows.length){ %><div class="empty-state"><h5>Semua jawaban sudah direview</h5></div><% } %></main><%- include('../partials/footer') %>
