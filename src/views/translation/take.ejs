<%- include('../partials/head') %><%- include('../partials/nav') %>
<main class="container page-pad"><div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4"><div><a href="/translation" class="back-link">← Kembali ke pengaturan</a><h1 class="h3 fw-bold mt-2">Terjemahkan ke Bahasa Inggris</h1></div><span class="chip">Soal <%= item.ordinal %> / <%= stats.total %></span></div>
 <div class="progress-track mb-4"><span style="width:<%= Math.round(stats.done / stats.total*100) %>%"></span></div>
 <div class="row justify-content-center"><div class="col-lg-8"><div class="question-panel"><span class="eyebrow">SOAL BAHASA INDONESIA</span><h2 class="quiz-question mt-3"><%= item.prompt_snapshot %></h2>
 <form id="translationForm" method="post" action="/translation/run/<%= run.id %>/answer"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="item_id" value="<%= item.id %>">
 <section id="stepTense"><label for="grammarFocus" class="form-label fw-bold">Tahap 1 · Pilih tense / struktur</label><select required name="chosen_focus" id="grammarFocus" class="form-select form-select-lg"><option value="">-- Pilih tense / struktur --</option><% Object.entries(focusLabels).forEach(([slug,label])=>{ %><option value="<%= slug %>"><%= label %></option><% }) %></select><button type="button" id="nextWriting" class="btn btn-brand mt-3">Lanjut menulis <i class="bi bi-arrow-right"></i></button></section>
 <section id="stepEnglish" class="d-none mt-3"><div class="d-flex justify-content-between flex-wrap gap-2 mb-3"><div><span class="small muted">Grammar dipilih:</span> <strong id="chosenFocusLabel"></strong></div><button type="button" id="changeFocus" class="btn btn-sm btn-outline-secondary">Ubah tense</button></div><label for="englishAnswer" class="form-label fw-bold">Tahap 2 · Tulis kalimat Inggris</label><textarea id="englishAnswer" name="english_answer" maxlength="600" minlength="3" required rows="4" class="form-control" placeholder="Ketik kalimat bahasa Inggris..." aria-describedby="answerHint"></textarea><p id="answerHint" class="small muted mt-2">Kapitalisasi dan tanda baca tidak memengaruhi pencocokan contoh. Jawaban alternatif yang valid dapat menunggu review admin.</p><button type="submit" class="btn btn-brand btn-lg">Kirim jawaban <i class="bi bi-send ms-1"></i></button></section>
 </form></div></div></div>
</main><script src="/js/translation.js" defer></script><%- include('../partials/footer') %>
