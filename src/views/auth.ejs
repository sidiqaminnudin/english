<%- include('partials/head') %><%- include('partials/nav') %><main class="auth-bg"><div class="container"><div class="auth-card"><div class="text-center mb-4"><div class="auth-symbol"><i class="bi bi-mortarboard-fill"></i></div><div class="section-kicker mt-3">WELCOME TO ENGLISHLAB</div><h1 class="h2 mt-2"><%= mode==='register'?'Buat akun belajarmu':'Selamat datang kembali' %></h1><p class="muted"><%= mode==='register'?'Simpan progres latihan dan nilai ujian.':'Lanjutkan perjalanan bahasa Inggrismu.' %></p></div><% if(error){ %><div class="alert alert-danger" role="alert"><%= error %></div><% } %><form method="post" action="/<%= mode %>"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="next" value="<%= next %>"><% if(mode==='register'){ %><div class="mb-3"><label for="full_name" class="form-label">Nama lengkap</label><input id="full_name" type="text" name="full_name" class="form-control form-control-lg" minlength="2" maxlength="120" required autocomplete="name" placeholder="Nama yang ditampilkan"></div><% } %><div class="mb-3"><label for="username" class="form-label">Username</label><input id="username" type="text" name="username" pattern="[a-z0-9_]{3,40}" class="form-control form-control-lg" required autocomplete="username" placeholder="contoh: siswa_01"></div><div class="mb-4"><label for="password" class="form-label">Password</label><input id="password" type="password" name="password" minlength="<%= mode==='register'?10:1 %>" maxlength="128" class="form-control form-control-lg" required autocomplete="<%= mode==='register'?'new-password':'current-password' %>" placeholder="Masukkan password"><% if(mode==='register'){ %><div class="form-text">Minimal 10 karakter. Jangan menggunakan password yang mudah ditebak.</div><% } %></div><button class="btn btn-brand btn-lg w-100" type="submit"><%= mode==='register'?'Daftar & mulai belajar':'Masuk ke akun' %> <i class="bi bi-arrow-right"></i></button></form><div class="auth-switch text-center mt-4"><% if(mode==='register'){ %>Sudah punya akun? <a href="/login">Masuk di sini</a><% }else{ %>Belum punya akun? <a href="/register">Daftar gratis</a><% } %></div></div></div></main><%- include('partials/footer') %>
