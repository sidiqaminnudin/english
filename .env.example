PORT=3000
BIND_HOST=127.0.0.1
NODE_ENV=development
DATABASE_URL=postgresql://english_lms:CHANGE_DB_PASSWORD@127.0.0.1:5432/english_lms
SESSION_SECRET=REPLACE_WITH_RANDOM_64_CHAR_SECRET
TRUST_PROXY=0
COOKIE_SECURE=false
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD
ADMIN_NAME=Administrator

# Optional writing feedback (server-side only). Select openai or 9router.
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_GRADING_MODEL=gpt-4.1-mini
# Used only when AI_PROVIDER=9router. HTTP allowed only on loopback; use HTTPS remotely.
NINE_ROUTER_API_KEY=
NINE_ROUTER_BASE_URL=http://127.0.0.1:20128/v1
NINE_ROUTER_MODEL=gemini/gemini-3.5-flash-lite
